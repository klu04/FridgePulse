# App
PROJECT_NAME=FridgePulse

# Neon: use the pooled URL for app traffic and the direct URL for migrations.
NEON_DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
MIGRATION_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Database
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=change_me
POSTGRES_SERVER=localhost

# Initial admin account
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change_me

USERS_OPEN_REGISTRATION=false

# Optional integrations
SPOONACULAR_API_KEY=change_me
RECIPES_URL=https://api.spoonacular.com/recipes/findByIngredients

# Test Database
TEST_DATABASE_URL=postgresql+asyncpg://username:password@localhost:port/dbname

# Required app secret
SECRET_KEY=replace_with_a_random_secret

